# ==============================================================================
# TopLuxe — Variables minimales pour faire fonctionner TLX-001 en local
# (sous-ensemble de .env.example — voir ce fichier pour la liste complète et les
# variables réservées aux tickets futurs, non nécessaires ici)
#
# Créé lors de TLX-001.3 (validation locale), à la demande explicite du point 4.
# Les deux SEULES variables réellement obligatoires pour démarrer l'application au
# stade actuel sont DATABASE_URL et SESSION_TOKEN_PEPPER (cf. shared/config/env.ts,
# schéma de validation Zod — toutes les autres variables ont une valeur par défaut
# ou sont optionnelles).
# ==============================================================================

# Obligatoire — connexion à une base PostgreSQL locale ou distante.
# Exemple pour une instance Postgres locale standard :
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/topluxe_dev"

# Obligatoire — chaîne secrète utilisée pour le hachage des tokens de session.
# Générer une valeur aléatoire locale, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_TOKEN_PEPPER="remplacer-par-une-valeur-aleatoire-generee-localement"

# Optionnelles mais recommandées en développement (valeurs par défaut sinon) :
NEXT_PUBLIC_PI_SANDBOX_MODE=true
NEXT_PUBLIC_APP_ENV=development
LOG_LEVEL=debug

# Tout le reste (Pi Network, stockage, e-mail, Sentry, FX_RATE_SOURCE_CONFIG) reste
# volontairement vide : ces modules ne sont pas développés à ce stade (TLX-001) et
# leurs variables ne sont pas requises pour que l'application démarre.
