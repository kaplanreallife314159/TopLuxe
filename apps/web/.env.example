# ==============================================================================
# TopLuxe — Variables d'environnement (exemple, AUCUNE valeur réelle)
# Conforme à "TopLuxe — Sprint 0 : Version Finale Verrouillée", section D.
# ==============================================================================

# --- Variables PUBLIQUES (exposées au client, préfixe NEXT_PUBLIC_) ---

# Active le mode sandbox du SDK Pi côté client (true en dev/staging, false en production mainnet)
NEXT_PUBLIC_PI_SANDBOX_MODE=true

# Identifiant d'environnement affichable (development / staging / production)
NEXT_PUBLIC_APP_ENV=development

# --- Variables SERVEUR uniquement (jamais exposées au client) ---

# Connexion PostgreSQL (Prisma)
DATABASE_URL=

# Taille du pool de connexions Prisma — À VALIDER selon le plan Render retenu (Sprint 0, point d'attention 2)
DATABASE_CONNECTION_LIMIT=

# Session serveur opaque (cf. Sprint 0, section E — PAS de JWT)
SESSION_COOKIE_NAME=topluxe_session
SESSION_TOKEN_PEPPER=

# Pi Network — clés API applicatives.
# NON nécessaires au flux d'authentification TLX-006 : GET https://api.minepi.com/v2/me
# (utilisé par PiTokenVerificationService) s'authentifie exclusivement avec
# "Authorization: Bearer <accessToken>" (Access Token, propre à l'utilisateur) — confirmé sur la
# page officielle Platform API ("Authorization method: Access token" pour /me, distinct de
# "Authorization method: Server API Key" pour les endpoints de paiement /payments/*).
# PI_API_KEY n'est requis que par les routes de paiement que le scaffolder pi-sdk-nextjs peut
# générer (app/api/pi_payment/*) — non implémentées dans ce dépôt (hors périmètre TLX-006, aucun
# U2A/A2U/escrow). Ne jamais renseigner de vraie clé ici tant qu'un ticket dédié aux paiements ne
# l'exige explicitement.
PI_API_KEY_TESTNET=
PI_API_KEY_MAINNET=

# Pi Network — portefeuille applicatif (NON nécessaires à ce ticket, réservées au module Paiements,
# hors périmètre du Sprint 0 — cf. décision "paiements non développés")
PI_APP_WALLET_PRIVATE_SEED_TESTNET=
PI_APP_WALLET_PRIVATE_SEED_MAINNET=

# Stockage objet compatible S3 (médias produits) — préparé, non utilisé à ce ticket
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=

# Stockage isolé et chiffré des documents KYC — préparé, non utilisé à ce ticket, DOIT rester
# distinct du stockage médias ci-dessus (exigence de sécurité déjà actée)
KYC_DOCUMENT_STORAGE_ENDPOINT=
KYC_DOCUMENT_STORAGE_ACCESS_KEY=
KYC_DOCUMENT_STORAGE_SECRET_KEY=
KYC_DOCUMENT_STORAGE_BUCKET=

# E-mails transactionnels — préparé, non utilisé à ce ticket
EMAIL_PROVIDER_API_KEY=

# Monitoring d'erreurs
SENTRY_DSN=

# Niveau de log (fatal|error|warn|info|debug|trace) — optionnel, défaut 'info'.
# Ajoutée lors de l'audit TLX-001.1 (P1) : utilisée par shared/logger/logger.ts, non documentée jusque-là.
LOG_LEVEL=

# NON CONFIRMÉ — NE PAS RENSEIGNER : aucune source de taux de change Pi/fiat officielle
# n'est confirmée par la documentation Pi Network à ce jour (cf. addendum Pi Network, point 11 ;
# Sprint 0, section M). Cette variable reste vide tant que le point n'est pas arbitré.
FX_RATE_SOURCE_CONFIG=

# Redis — RETIRÉ du MVP initial (Sprint 0, décision verrouillée). Ne pas renseigner ni utiliser
# tant qu'une décision explicite de réintroduction n'a pas été prise.
# REDIS_URL=
